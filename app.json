{
  "expo": {
    "name": "ThaLinq",
    "slug": "ThaLinq",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/ThaLinq.jpg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "notification": {
      "icon": "./assets/ThaLinq.jpg",
      "color": "#6366F1"
    },
    "splash": {
      "image": "./assets/ThaLinq.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thalinq.app",
      "buildNumber": "11",
      "usesIosPushNotifications": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "ThaLinq requires access to your photo library to allow you to upload a profile picture and share photos of events or parties within your groups.",
        "NSCameraUsageDescription": "ThaLinq requires access to your camera for live streaming and posting photos to your groups.",
        "NSMicrophoneUsageDescription": "ThaLinq requires access to your microphone so others can hear you during your live streams."
      }
    },
    "android": {
      "usesCleartextTraffic": false,
      "googleServicesFile": "./google-services.json",
      "versionCode": 6,
      "package": "com.thalinq.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/ThaLinq.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": true,
            "targetSdkVersion": 35,
            "compileSdkVersion": 35
          },
          "ios": {
            "useFrameworks": "static",
            "newArchEnabled": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/ThaLinq.jpg",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ThaLinq to access your photos.",
          "cameraPermission": "Allow ThaLinq to access your camera."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "72254f3a-d754-40e9-9827-3e901840cb68"
      }
    }
  }
}